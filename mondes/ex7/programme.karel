# Projet : Karel le jardinier
definir tourner_droite:
    repeter 3 fois:
        tourner_gauche

repeter 2 fois:
    tant que devant_libre:
        avancer
        si balise_ici:
            ramasser_balise
    tourner_gauche
    avancer
    tourner_gauche
    tant que devant_libre:
        avancer
        si balise_ici:
            ramasser_balise
    tourner_droite
    si devant_libre:    
        avancer
        tourner_droite