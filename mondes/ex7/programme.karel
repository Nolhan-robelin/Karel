# Projet : Karel le jardinier
definir tourner_droite:
    repeter 3 fois:
        tourner_gauche

definir ramasser_toute_balise:
    tant que balise_ici:
        ramasser_balise


definir ramasser_ligne:
    tant que devant_libre:
        si balise_ici:

            ramasser_toute_balise

        avancer
            
        si balise_ici:

            ramasser_toute_balise

definir changer_ligne:
    
    si balise_ici:
        ramasser_toute_balise
    
    si regarde_est:
        si gauche_libre:
            tourner_gauche
            avancer
            tourner_gauche
    
    sinon:
        si droite_libre:
            tourner_droite
            avancer
            tourner_droite

si regarde_sud:   
    ramasser_ligne
    tourner_droite
    ramasser_ligne
    tourner_gauche
    tourner_gauche

si regarde_nord:
    tourner_gauche
    tourner_gauche
    ramasser_ligne
    tourner_gauche

repeter 6 fois :
    ramasser_ligne
    changer_ligne
